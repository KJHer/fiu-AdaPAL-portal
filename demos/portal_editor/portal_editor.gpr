with "portal";

project Portal_Editor is
   for Source_Dirs use ("src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Create_Missing_Dirs use "True";
   for Main use ("portal_editor.adb");

   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnata", "-gnatwa", "-gnatwe",
         "-gnatVa", "-gnatyg", "-gnatyM100", "-g", "-O1");
   end Compiler;
end Portal_Editor;
